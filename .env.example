# Copy this file to `.env` and fill in your real key.
# `.env` is gitignored — do not commit it.

ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model. Default is claude-sonnet-4-6.
# CLAUDE_MODEL=claude-sonnet-4-6

# Optional: override the port. Default is 5050.
# PORT=5050

# Optional: enable the shared-password gate. Anyone hitting the site must
# enter this password once; we set a signed cookie that lasts a week.
# Leave unset for local-only dev — gate is disabled when empty.
# ACCESS_PASSWORD=ampexpo2026

# Optional: cookie signing secret. Defaults to ACCESS_PASSWORD if unset.
# Set this if you want to rotate cookies independently of the password.
# ACCESS_COOKIE_SECRET=some-long-random-string
